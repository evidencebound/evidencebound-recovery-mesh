# Vertex AI + Cloud Run configuration. Never commit real credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=evidencebound-rm-c977c1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_RUN_REGION=europe-west1
RECOVERY_MESH_MODEL=gemini-3.5-flash

# Public judge deployment must use google_adk. Deterministic is test-only.
RECOVERY_MESH_EXECUTION_MODE=google_adk

# Process-local invocation guard for the public judge endpoint. This is not a billing/spend cap.
RECOVERY_MESH_LIVE_MODEL_CALL_BUDGET=64
