{
  "schema_version": 1,
  "repository": "evidencebound/evidencebound-recovery-mesh",
  "policy": {
    "development": "audit",
    "frozen": "audit"
  },
  "bootstrap": [
    {
      "id": "install-dev",
      "command": "python -m pip install '.[dev]'",
      "timeout_seconds": 900
    }
  ],
  "suites": [
    {
      "id": "deterministic-tests",
      "phase": "development",
      "command": "pytest -q -m \"not integration\"",
      "hard_gate": true,
      "timeout_seconds": 1800
    },
    {
      "id": "fleet-scale-recovery-probe",
      "phase": "development",
      "command": "PYTHONPATH=src python scripts/benchmark-scale.py",
      "hard_gate": true,
      "timeout_seconds": 300
    }
  ],
  "freeze": {
    "enabled": false
  }
}
